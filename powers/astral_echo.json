{
  "type": "origins:multiple",
  "name": "Friend from the Shadows",
  "description": "A small storm follows you and answers to you alone, and listens to your every word.",
  "tick": {
    "type": "origins:action_over_time",
    "interval": 1,
    "entity_action": {
      "type": "origins:execute_command",
      "command": "function finoison:pet_tick",
      "permission_level": 4
    }
  },
  "strike": {
    "type": "origins:action_on_hit",
    "bientity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:target_action",
          "action": {
            "type": "origins:execute_command",
            "command": "tag @s add finoison_pet_marked",
            "permission_level": 4
          }
        },
        {
          "type": "origins:actor_action",
          "action": {
            "type": "origins:execute_command",
            "command": "function finoison:pet_mark",
            "permission_level": 4
          }
        }
      ]
    }
  },
  "retaliate": {
    "type": "origins:attacker_action_when_hit",
    "cooldown": 1,
    "entity_action": {
      "type": "origins:execute_command",
      "command": "tag @s add finoison_pet_hurt",
      "permission_level": 4
    }
  }
}
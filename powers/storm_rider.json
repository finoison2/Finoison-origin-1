{
  "type": "origins:multiple",
  "name": "Storm Rider",
  "description": "Only you may ride the storm. It goes where you look: up when you look up, down when you look down. Crouch to climb off, and jump to loose a beam where you are looking.",
  "use": {
    "type": "origins:action_on_entity_use",
    "condition": {
      "type": "origins:sneaking",
      "inverted": true
    },
    "bientity_condition": {
      "type": "origins:target_condition",
      "condition": {
        "type": "origins:entity_type",
        "entity_type": "minecraft:wither"
      }
    },
    "bientity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:target_action",
          "action": {
            "type": "origins:execute_command",
            "command": "tag @s add finoison_pet_use",
            "permission_level": 4
          }
        },
        {
          "type": "origins:actor_action",
          "action": {
            "type": "origins:execute_command",
            "command": "function finoison:pet_mount",
            "permission_level": 4
          }
        }
      ]
    }
  },
  "forward": {
    "type": "origins:active_self",
    "condition": {
      "type": "origins:command",
      "command": "execute on vehicle if entity @s[type=minecraft:wither,tag=finoison_pet]",
      "comparison": "==",
      "compare_to": 1
    },
    "entity_action": {
      "type": "origins:execute_command",
      "command": "function finoison:ride_f",
      "permission_level": 4
    },
    "key": {
      "key": "key.forward",
      "continuous": true
    },
    "hud_render": {
      "should_render": false
    }
  },
  "back": {
    "type": "origins:active_self",
    "condition": {
      "type": "origins:command",
      "command": "execute on vehicle if entity @s[type=minecraft:wither,tag=finoison_pet]",
      "comparison": "==",
      "compare_to": 1
    },
    "entity_action": {
      "type": "origins:execute_command",
      "command": "function finoison:ride_b",
      "permission_level": 4
    },
    "key": {
      "key": "key.back",
      "continuous": true
    },
    "hud_render": {
      "should_render": false
    }
  },
  "left": {
    "type": "origins:active_self",
    "condition": {
      "type": "origins:command",
      "command": "execute on vehicle if entity @s[type=minecraft:wither,tag=finoison_pet]",
      "comparison": "==",
      "compare_to": 1
    },
    "entity_action": {
      "type": "origins:execute_command",
      "command": "function finoison:ride_l",
      "permission_level": 4
    },
    "key": {
      "key": "key.left",
      "continuous": true
    },
    "hud_render": {
      "should_render": false
    }
  },
  "right": {
    "type": "origins:active_self",
    "condition": {
      "type": "origins:command",
      "command": "execute on vehicle if entity @s[type=minecraft:wither,tag=finoison_pet]",
      "comparison": "==",
      "compare_to": 1
    },
    "entity_action": {
      "type": "origins:execute_command",
      "command": "function finoison:ride_r",
      "permission_level": 4
    },
    "key": {
      "key": "key.right",
      "continuous": true
    },
    "hud_render": {
      "should_render": false
    }
  },
  "shoot": {
    "type": "origins:active_self",
    "condition": {
      "type": "origins:command",
      "command": "execute on vehicle if entity @s[type=minecraft:wither,tag=finoison_pet]",
      "comparison": "==",
      "compare_to": 1
    },
    "entity_action": {
      "type": "origins:execute_command",
      "command": "function finoison:ride_shoot",
      "permission_level": 4
    },
    "key": {
      "key": "key.jump",
      "continuous": false
    },
    "hud_render": {
      "should_render": false
    },
    "cooldown": 20
  }
}